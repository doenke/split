# --- General ---
# public URL (HTTPS is required for passkeys, PWA, camera)
PUBLIC_URL=https://split.example.de
TZ=Europe/Berlin
DEFAULT_CURRENCY=EUR

# --- Database ---
# e.g. openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- OIDC ---
OIDC_ISSUER=https://auth.example.de/application/o/split/
OIDC_CLIENT_ID=split
OIDC_CLIENT_SECRET=change-me
OIDC_SCOPES=openid profile email groups
# members of this IdP group are instance admins (default: admins)
OIDC_ADMIN_GROUP=admins
OIDC_BUTTON_LABEL=Mit Authentik anmelden
# Redirect URI to register at the IdP: https://split.example.de/auth/oidc/callback

# --- Passkeys (WebAuthn) ---
# RP ID is derived from PUBLIC_URL
WEBAUTHN_RP_NAME=Split

# --- Receipt recognition (optional) ---
# With an API key, photographed receipts are read automatically by Claude (Anthropic).
# The receipt image is sent to the Anthropic API for this.
# ANTHROPIC_API_KEY=sk-ant-...
# anthropic (default) | none
# RECEIPT_OCR_ENGINE=anthropic
# default: claude-opus-5-5
# RECEIPT_MODEL=

# --- Optional: e-mails ---
# Active as soon as SMTP_HOST is set. People choose themselves which mails they get (few by default).
# SMTP_HOST=mail.example.de
# SMTP_PORT=587
# SMTP_SECURE=false                       # true = TLS from the start (port 465); false = STARTTLS
# SMTP_USER=split@example.de
# SMTP_PASS=
# SMTP_FROM=Split <split@example.de>

# --- Development only ---
# DEV_LOGIN=true                          # login form without IdP – never enable in production

# --- Optional: push notifications ---
# Generated automatically and stored in the database if not set.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.de
