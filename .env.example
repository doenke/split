# --- General ---
PUBLIC_URL=https://split.example.de      # public URL (HTTPS is required for passkeys, PWA, camera)
TZ=Europe/Berlin
DEFAULT_CURRENCY=EUR

# --- Database ---
POSTGRES_PASSWORD=change-me              # e.g. openssl rand -hex 24

# --- OIDC ---
OIDC_ISSUER=https://auth.example.de/application/o/split/
OIDC_CLIENT_ID=split
OIDC_CLIENT_SECRET=change-me
OIDC_SCOPES="openid profile email"
OIDC_ADMIN_GROUP=split-admins            # members of this IdP group are instance admins
OIDC_BUTTON_LABEL="Mit Authentik anmelden"
# Redirect URI to register at the IdP: https://split.example.de/auth/oidc/callback

# --- Passkeys (WebAuthn) ---
WEBAUTHN_RP_NAME=Split                    # RP ID is derived from PUBLIC_URL

# --- Development only ---
# DEV_LOGIN=true                          # login form without IdP – never enable in production
