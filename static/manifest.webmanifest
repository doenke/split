{
	"name": "Split – Kosten fair teilen",
	"short_name": "Split",
	"description": "Gemeinsame Ausgaben in Gruppen fair aufteilen.",
	"lang": "de",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#f4f6f5",
	"theme_color": "#2a6f5f",
	"icons": [
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png"
		},
		{
			"src": "/icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml"
		}
	],
	"shortcuts": [
		{
			"name": "Meine Gruppen",
			"url": "/",
			"icons": [
				{
					"src": "/icon-192.png",
					"sizes": "192x192"
				}
			]
		},
		{
			"name": "Beleg hinzufügen",
			"url": "/teilen",
			"icons": [
				{
					"src": "/icon-192.png",
					"sizes": "192x192"
				}
			]
		}
	],
	"share_target": {
		"action": "/teilen",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"files": [
				{
					"name": "file",
					"accept": [
						"image/*",
						"application/pdf"
					]
				}
			]
		}
	}
}
